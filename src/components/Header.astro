---
interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = baseUrl || '/';
---

<header class="site-header">
  <div class="header-inner">
    <div class="brand">
      {
        isHome ? (
          <h1 class="site-title">
            <a href={homeUrl}>Blog Personal de Carlos Castaños</a>
          </h1>
        ) : (
          <p class="site-title">
            <a href={homeUrl}>Blog Personal de Carlos Castaños</a>
          </p>
        )
      }
    </div>
    <nav class="site-nav" aria-label="Navegación principal">
      <ul>
        <li><a href={`${homeUrl}#articulos`}>Artículos</a></li>
        <li><a href={`${homeUrl}#sobre-mi`}>Sobre mí</a></li>
        <li>
          <a
            href="https://github.com/Carlitic/blog-personal"
            target="_blank"
            rel="noopener noreferrer">Repositorio</a
          >
        </li>
      </ul>
    </nav>
  </div>
</header>
